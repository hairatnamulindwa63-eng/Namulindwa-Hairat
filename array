' Assignment: Two-Dimensional Arrays

Module Arrays

    Sub Main()

        ' Store the marks of students in a two-dimensional array
        Dim studentMarks(,) As Integer = {
            {75, 80, 90, 85},
            {80, 85, 95, 90},
            {90, 95, 81, 80},
            {85, 90, 80, 75}
        }

        ' Display all the student marks
        Console.WriteLine("Student Marks:")

        For i As Integer = 0 To studentMarks.GetLength(0) - 1
            For j As Integer = 0 To studentMarks.GetLength(1) - 1
                Console.Write(studentMarks(i, j) 
            Next
            Console.WriteLine()
        Next

        ' Display the mark 81 from the array
        Console.WriteLine("The mark is: " & studentMarks(2, 2))

        Console.ReadLine()

    End Sub

End Module